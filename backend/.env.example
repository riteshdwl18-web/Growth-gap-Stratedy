# Backend app settings
APP_NAME=Growth Gap Strategy API
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/growth_gap_strategy

# Session/auth settings
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Comma-separated origins allowed by backend CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scraper pacing and retry controls
SCRAPER_MIN_DELAY_SECONDS=1.2
SCRAPER_MAX_DELAY_SECONDS=2.2
SCRAPER_RETRY_MAX_ATTEMPTS=3
SCRAPER_BACKOFF_BASE_SECONDS=15
SCRAPER_BACKOFF_MAX_SECONDS=180
SCRAPER_BACKOFF_JITTER_SECONDS=1.5
