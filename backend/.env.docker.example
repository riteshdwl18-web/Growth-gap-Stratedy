# Core app
APP_NAME=Growth Gap Strategy API
APP_VERSION=1.0.0

# Postgres and Redis inside Docker network
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/growth_gap_strategy
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Session/auth settings
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Public origins that can call this API (IP-only deployment example)
CORS_ORIGINS=http://13.50.245.2

# Google OAuth settings
# - Set GOOGLE_OAUTH_ENABLED=true only after creating OAuth credentials in Google Cloud.
# - For production, GOOGLE_REDIRECT_URI must be HTTPS and must exactly match the URI in Google console.
# - Google OAuth will not work reliably on raw public IP deployments; use a domain + TLS.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OAUTH_STATE_TTL_MINUTES=10

# Scraper pacing and retry controls
SCRAPER_MIN_DELAY_SECONDS=1.2
SCRAPER_MAX_DELAY_SECONDS=2.2
SCRAPER_RETRY_MAX_ATTEMPTS=3
SCRAPER_BACKOFF_BASE_SECONDS=15
SCRAPER_BACKOFF_MAX_SECONDS=180
SCRAPER_BACKOFF_JITTER_SECONDS=1.5
