# Production environment for Docker Compose deployment
APP_NAME=Growth Gap Strategy API
APP_VERSION=1.0.0

# Internal service addresses in compose network
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/growth_gap_strategy
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Session/auth settings
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Local frontend origins for dockerized local usage
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Scraper pacing and retry controls
SCRAPER_MIN_DELAY_SECONDS=1.2
SCRAPER_MAX_DELAY_SECONDS=2.2
SCRAPER_RETRY_MAX_ATTEMPTS=3
SCRAPER_BACKOFF_BASE_SECONDS=15
SCRAPER_BACKOFF_MAX_SECONDS=180
SCRAPER_BACKOFF_JITTER_SECONDS=1.5
